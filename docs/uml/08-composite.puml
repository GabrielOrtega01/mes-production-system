@startuml
title Patron Composite - Jerarquia de Produccion (FabricaViva MES)

skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #333333
}

interface UnidadProduccion <<Componente>> {
  + getCapacidadTotal() : double
  + getTotalMaquinas() : int
  + mostrar(prefijo : String) : void
}

class Maquina <<Hoja>> {
  - nombre : String
  - capacidad : double
  --
  + Maquina(nombre : String, capacidad : double)
  + getCapacidadTotal() : double
  + getTotalMaquinas() : int
  + mostrar(prefijo : String) : void
  + getNombre() : String
}

class Estacion <<Composite>> {
  - nombre : String
  - hijos : List<UnidadProduccion>
  --
  + Estacion(nombre : String)
  + agregar(u : UnidadProduccion) : void
  + quitar(u : UnidadProduccion) : void
  + getCapacidadTotal() : double
  + getTotalMaquinas() : int
  + mostrar(prefijo : String) : void
}

class LineaFabricacion <<Composite>> {
  - nombre : String
  - hijos : List<UnidadProduccion>
  --
  + LineaFabricacion(nombre : String)
  + agregar(u : UnidadProduccion) : void
  + quitar(u : UnidadProduccion) : void
  + getCapacidadTotal() : double
  + getTotalMaquinas() : int
  + mostrar(prefijo : String) : void
}

class Planta <<Composite>> {
  - nombre : String
  - hijos : List<UnidadProduccion>
  --
  + Planta(nombre : String)
  + agregar(u : UnidadProduccion) : void
  + quitar(u : UnidadProduccion) : void
  + getCapacidadTotal() : double
  + getTotalMaquinas() : int
  + mostrar(prefijo : String) : void
}

class PruebaComposite <<Cliente>> {
  + pruebas JUnit 5 (11)
}

' Realizaciones
UnidadProduccion <|.. Maquina
UnidadProduccion <|.. Estacion
UnidadProduccion <|.. LineaFabricacion
UnidadProduccion <|.. Planta

' Composicion recursiva
Estacion       "1" o--> "*" UnidadProduccion : hijos
LineaFabricacion "1" o--> "*" UnidadProduccion : hijos
Planta          "1" o--> "*" UnidadProduccion : hijos

' Cliente
PruebaComposite ..> UnidadProduccion : <<use>>

@enduml
