@startuml
title Patron Decorator - Costo de Orden de Produccion (FabricaViva MES)

skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #333333
}

interface CalculoCostoOrden <<Componente>> {
  + calcularCosto() : double
  + describir() : String
}

class CostoBaseOrden <<ComponenteConcreto>> {
  - codigoOrden : String
  - costoBase : double
  --
  + CostoBaseOrden(codigoOrden : String, costoBase : double)
  + calcularCosto() : double
  + describir() : String
}

abstract class DecoradorCosto <<DecoradorAbstracto>> {
  # componente : CalculoCostoOrden
  --
  + DecoradorCosto(componente : CalculoCostoOrden)
}

class RecargoPrioritario <<DecoradorConcreto>> {
  + RecargoPrioritario(componente : CalculoCostoOrden)
  + calcularCosto() : double
  + describir() : String
}

class CargoHorasExtra <<DecoradorConcreto>> {
  + CargoHorasExtra(componente : CalculoCostoOrden)
  + calcularCosto() : double
  + describir() : String
}

class DescuentoVolumen <<DecoradorConcreto>> {
  + DescuentoVolumen(componente : CalculoCostoOrden)
  + calcularCosto() : double
  + describir() : String
}

class DescuentoClientePreferente <<DecoradorConcreto>> {
  + DescuentoClientePreferente(componente : CalculoCostoOrden)
  + calcularCosto() : double
  + describir() : String
}

class PruebaDecorator <<Cliente>> {
  + pruebas JUnit 5 (9)
}

' Realizaciones
CalculoCostoOrden <|.. CostoBaseOrden
CalculoCostoOrden <|.. DecoradorCosto

' Jerarquía decoradores
DecoradorCosto <|-- RecargoPrioritario
DecoradorCosto <|-- CargoHorasExtra
DecoradorCosto <|-- DescuentoVolumen
DecoradorCosto <|-- DescuentoClientePreferente

' Envoltorio
DecoradorCosto "1" o--> "1" CalculoCostoOrden : componente

' Cliente
PruebaDecorator ..> CalculoCostoOrden : <<use>>

' Orden visual
RecargoPrioritario -[hidden]right- CargoHorasExtra
CargoHorasExtra -[hidden]right- DescuentoVolumen
DescuentoVolumen -[hidden]right- DescuentoClientePreferente

@enduml
