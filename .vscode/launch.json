{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "1. Prueba Singleton",
      "request": "launch",
      "mainClass": "com.fabricaviva.pruebas.PruebaSingleton",
      "classPaths": ["${workspaceFolder}/target/classes"],
      "console": "integratedTerminal"
    },
    {
      "type": "java",
      "name": "2. Prueba Factory Method",
      "request": "launch",
      "mainClass": "com.fabricaviva.pruebas.PruebaFactoryMethod",
      "classPaths": ["${workspaceFolder}/target/classes"],
      "console": "integratedTerminal"
    },
    {
      "type": "java",
      "name": "3. Prueba Builder",
      "request": "launch",
      "mainClass": "com.fabricaviva.pruebas.PruebaBuilder",
      "classPaths": ["${workspaceFolder}/target/classes"],
      "console": "integratedTerminal"
    },
    {
      "type": "java",
      "name": "4. Prueba Abstract Factory",
      "request": "launch",
      "mainClass": "com.fabricaviva.pruebas.PruebaAbstractFactory",
      "classPaths": ["${workspaceFolder}/target/classes"],
      "console": "integratedTerminal"
    },
    {
      "type": "java",
      "name": "5. Prueba Prototype",
      "request": "launch",
      "mainClass": "com.fabricaviva.pruebas.PruebaPrototype",
      "classPaths": ["${workspaceFolder}/target/classes"],
      "console": "integratedTerminal"
    },
    {
      "type": "java",
      "name": "6. Prueba Bridge",
      "request": "launch",
      "mainClass": "com.fabricaviva.pruebas.PruebaBridge",
      "classPaths": ["${workspaceFolder}/target/classes"],
      "console": "integratedTerminal"
    },
    {
      "type": "java",
      "name": "7. Prueba Adapter",
      "request": "launch",
      "mainClass": "com.fabricaviva.pruebas.PruebaAdapter",
      "classPaths": ["${workspaceFolder}/target/classes"],
      "console": "integratedTerminal"
    },
    {
      "type": "java",
      "name": "8. JUnit — Composite y Decorator",
      "request": "launch",
      "mainClass": "org.junit.platform.console.ConsoleLauncher",
      "args": [
        "execute",
        "--class-path", "${workspaceFolder}/target/classes",
        "--select-class=com.fabricaviva.pruebas.PruebaComposite",
        "--select-class=com.fabricaviva.pruebas.PruebaDecorator"
      ],
      "classPaths": [
        "${workspaceFolder}/target/classes",
        "${workspaceFolder}/lib/junit-platform-console-standalone-1.10.3.jar"
      ],
      "console": "integratedTerminal"
    }
  ]
