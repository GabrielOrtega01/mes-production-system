{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilar (Java 24)",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\compile.ps1"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$javac",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
